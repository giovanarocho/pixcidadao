# ==========================================================================
# Pix Cidadao - variaveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# Sem MERCADO_PAGO_ACCESS_TOKEN, o site roda em MODO SIMULADO:
#   - cobranca Pix falsa, confirmada automaticamente apos alguns segundos
# Com MERCADO_PAGO_ACCESS_TOKEN preenchido, a cobranca passa a ser um Pix
# de verdade, e a confirmacao consulta a API do Mercado Pago ao vivo.
# ==========================================================================

# --- Gateway de pagamento (Mercado Pago) ---------------------------------
# Pegue em https://www.mercadopago.com.br/developers/panel/app
# (crie uma aplicação, se ainda não tiver uma, e copie o "Access Token" —
# use primeiro o de TESTE para validar, depois troque pelo de PRODUÇÃO).
# Deixe em branco para manter o modo simulado.
MERCADO_PAGO_ACCESS_TOKEN=

# Assinatura do webhook do Mercado Pago — ainda não é validada pelo código
# (ver TODO em src/app/api/webhook/mercadopago/route.ts). Pode deixar em
# branco por enquanto; o fluxo de compra funciona sem isso.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- Banco de dados (Supabase) — Rede de Comunicadores --------------------
# Sem essas 2 variáveis preenchidas (URL + SERVICE_ROLE_KEY), o e-book
# continua vendendo normalmente, mas a Rede de Comunicadores (cadastro,
# aprovação, link de indicação, painel de vendas por comunicador) fica
# indisponível. Veja "Ativando a Rede de Comunicadores" no README.
# Rode supabase-schema.sql no SQL Editor do seu projeto Supabase antes.
NEXT_PUBLIC_SUPABASE_URL=
# ATENÇÃO: use a "service_role" key (não a "anon"/pública) — ela só é usada
# no servidor e nunca deve ser exposta no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel administrativo (/admin/comunicadores) --------------------------
# Senha para aprovar/recusar cadastros de comunicadores. Escolha algo longo
# e único — quem tiver essa senha consegue aprovar comunicadores. Acesse em
# /admin/comunicadores?senha=SUA_SENHA
ADMIN_PASSWORD=

# --- E-mail transacional (opcional, ex: Resend) ---------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Geral ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pixcidadao.app.br

# Usada para assinar o "saleId" sem precisar de banco de dados — tanto no
# modo simulado quanto no modo real com Mercado Pago (é o que faz a
# confirmação funcionar corretamente na Vercel, não só localmente).
# Pode deixar em branco para testar: um valor padrão é usado automaticamente.
# Antes de ir para produção com pagamentos de verdade, defina uma string
# aleatória própria aqui (evita que alguém de fora consiga forjar um link
# de download válido).
SALE_TOKEN_SECRET=
